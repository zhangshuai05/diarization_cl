  "schema": "v13-selector-score-diagnosis-v1",
  "gate": "rttm",
  "question": "候选评分（silhouette/objective）与最终句级质量为什么分叉？",
  "method": "对每场每 K=1..10 记录 score / objective / eligible / 句级 clean 归属错误率，逐场对齐。",
  "findings": {
    "scale_mismatch": {
      "silhouette_within_meeting_span": "0.049-0.279",
      "error_rate_within_meeting_span_points": "1.3-54.0",
      "reading": "评分的场内跨度比错误率跨度小 1-2 个数量级。评分在候选之间几乎无分辨力，选 K 实际由惩罚项与噪声驱动，而不是由哪个划分更好驱动。"
    },
    "spearman_rho_score_vs_error": -0.617,
    "rho_note": "跨 (场次, k) 的秩相关为负：silhouette 越高，错误率越高。这与「用轮廓系数选 K」的直觉相反。",
    "production_rule_accuracy": "12 场中 5 场选到句级最优 K",
    "direction": {
      "needs_larger_K": 7,
      "needs_smaller_K": 2,
      "already_optimal": 3,
      "penalty_direction": "MULTI_K_PENALTY=0.005/簇把选择往更小的 K 推，而多数坏场恰恰需要更大的 K —— 方向相反。"
    },
    "penalty_changed_choice_in": 4,
