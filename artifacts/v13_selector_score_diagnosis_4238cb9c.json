  "counterfactual_rules": {
    "note": "全部读真值评估，仅诊断。且 dev 与 holdout 都不是留出集（min_win 已在全部 20 场上调过，见 unlocked_selector docstring）。",
    "dev_12": {
      "production_objective_penalty": 0.0915,
